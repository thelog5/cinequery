{
  "name": "cinequery",
  "version": "0.1.0",
  "private": true,
  "description": "Ask movie questions in plain English; get an answer, a chart, and the SQL behind it.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:ops": "tsx scripts/apply-sql.ts db/ops.sql",
    "db:load": "tsx scripts/load-imdb.ts",
    "db:roles": "tsx scripts/setup-roles.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "ask": "tsx scripts/ask.ts",
    "eval": "tsx evals/run.ts",
    "eval:check-gold": "tsx evals/check-gold.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
