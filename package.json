{
  "name": "cinequery",
  "version": "0.1.0",
  "private": true,
  "description": "Ask movie questions in plain English; get an answer, a chart, and the SQL behind it.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:schema": "tsx scripts/apply-sql.ts db/schema.sql",
    "db:load": "tsx scripts/load-imdb.ts",
    "db:roles": "tsx scripts/apply-sql.ts db/roles.sql",
    "mcp": "tsx src/mcp/stdio.ts",
    "ask": "tsx scripts/ask.ts",
    "eval": "tsx evals/run.ts",
    "eval:check-gold": "tsx evals/check-gold.ts"
  }
}
