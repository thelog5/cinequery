# --- Database (Neon in prod, local Postgres in dev) ---
# Owner connection: used ONLY by scripts (schema, loader, role setup). Never set this on Vercel.
DATABASE_URL_ADMIN=postgres://user:pass@localhost:5432/cinequery
# Read-only role used by the agent's tools (SELECT only, 5s statement_timeout).
DATABASE_URL_READONLY=postgres://cinequery_reader:change-me@localhost:5432/cinequery
# Narrow role that can only write rate-limit / spend rows in the ops schema.
DATABASE_URL_OPS=postgres://cinequery_ops:change-me@localhost:5432/cinequery

# Passwords the role script sets (db/roles.sql reads these via psql vars / apply-sql)
READER_PASSWORD=change-me
OPS_PASSWORD=change-me

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model for the public demo and default eval runs
CINEQUERY_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CINEQUERY_EFFORT=medium

# --- Abuse controls (R8) ---
RATE_LIMIT_PER_HOUR=10
DAILY_SPEND_CAP_USD=5
